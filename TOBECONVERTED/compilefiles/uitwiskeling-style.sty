%% Paginanummer in verfstreep. Breedte blokje=extended margin.
\newcommand*{\pagenrblockR}{%
	\raisebox{-.6\height}{\includegraphics[width=\extendmargin,keepaspectratio]{\rubriekpagenrbg}}%
	\hspace*{-.5\extendmargin}%
	\makebox[0pt][c]{\textcolor{white}{\textbf{\thepage}}}%
	\hspace*{.5\extendmargin}%
}
\newcommand*{\pagenrblockL}{%
	\raisebox{-.6\height}{\reflectbox{\includegraphics[width=\extendmargin,keepaspectratio]{\rubriekpagenrbg}}}%
	\hspace*{-.5\extendmargin}%
	\makebox[0pt][c]{\textcolor{white}{\textbf{\thepage}}}%
	\hspace*{.5\extendmargin}%
}

%% Definieer een nieuwe paginastijl: uitwiskeling
\fancypagestyle{uitwiskeling}{ %
	\fancyhf{}  								% verwijder alle stijldefinities
	\addtolength{\headwidth}{2\extendmargin}  	% verander breedte van header & footer, default is \textwidth
	\fancyhfoffset[F]{\extendmargin}			% hercentreer footer na verbreden
	\renewcommand*{\headrulewidth}{0pt}			% geen header lijn
	\renewcommand*{\footrulewidth}{1pt}			% footer lijn dikte
	\renewcommand*{\footrule}{{\color{\rubriekkleur}\oldfootrule}} % footer lijn kleur
	
	%% Kopteksten
	\fancyhead[LE]{\sffamily\small\bfseries\color{\rubriekkleur}%
		\raisebox{-.25\height}{\includegraphics[width=5mm,keepaspectratio]{\rubriekheaderimg}}%	
		\enspace \MakeUppercase{\leftmark}}
	
	\fancyhead[RO]{\sffamily\small\sbseries\color{\rubriekkleur}%
		\raisebox{-.25\height}{\rule{0pt}{5mm}}%	
		\rightmark}
	
	%% Voetteksten
	\fancyfoot[LE]{{\sffamily\small\color{\rubriekkleur}\pagenrblockL \quad Uitwiskeling \uitgavenr \enspace \textendash \enspace \uitgaveseizoen}}
	
	\fancyfoot[RO]{{\sffamily\small\color{\rubriekkleur}Uitwiskeling \uitgavenr \enspace \textendash \enspace \uitgaveseizoen \quad \pagenrblockR}}
}

