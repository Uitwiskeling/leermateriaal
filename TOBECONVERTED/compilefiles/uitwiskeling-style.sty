	\markboth{}{}%  				% voor rubrieknaam in header
	%\pagestyle{plain}%				% geen header, enkel footer
}


%% DEFINIEER ARTIKELHOOFDINGEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Start nieuw artikel commando - typeset hoofding
%% \artikel{titel}{subtitel}{auteur}
%% Argument 1: titel 
%% Argument 2: subtitel, mag leeg zijn
%% Argument 3: auteur, mag leeg zijn
\newcommand*{\artikel}[3]{%
	{\raggedright\artikelbasis{#1}{#2}{#3}\par}}

%% ENKEL HULPMACRO: Artikelhoofding rechts uitgelijnd (voor foto versie)
\newcommand*{\artikelrechts}[3]{%
	{\raggedleft\artikelbasis{#1}{#2}{#3}\par}}

%% ENKEL HULPMACRO: Basiscommando voor artikelhoofding
\newcommand*{\artikelbasis}[3]{%
	\thispagestyle{plain}%				% geen header
	\FloatBarrier						% floats van vorig artikel mogen niet verder komen
	%#1=TITEL
	{\setstretch{0.9}\setlength{\parskip}{0ex}\sffamily\bfseries\Huge#1\par}%
	%#2=SUBTITEL
	\setbox0=\vbox{#2\unskip}\ifdim\wd0=0pt%
		%#subtitel is leeg, doe niets (ook geen vspace)
	\else%
		{\setstretch{1.0}\setlength{\parskip}{0ex}\sffamily\sbseries\huge#2\par}%
	\fi%
	\vspace{3.5ex}%
	%#3=AUTEUR
	\setbox0=\vbox{#3\unskip}\ifdim\wd0=0pt%
		%auteur is leeg, doe niets (ook geen vspace)
	\else%
		{\setstretch{1.0}\setlength{\parskip}{0ex}\sffamily\sbseries\Large#3\par}%
		\vspace{4ex}%
	\fi%
	\textcolor{\rubriekkleur}{\rule{16mm}{5pt}}%
	\vspace{3.5ex plus 1.0ex minus 1.0ex}%
	\refstepcounter{chapter}%			% "nummer" artikels als chapters
	\phantompageref%					% zodat links naar linkerbovenhoek pagina gaan
	\addcontentsline{toc}{chapter}{#1}%	% voor artikelnaam in TOC
	\markright{#1}%   					% voor artikelnaam in header
	\setcounter{figure}{0}              % nummering figuren opnieuw op 0 zetten
	\setcounter{table}{0}              	% nummering tabellen opnieuw op 0 zetten
}

%% Start nieuw artikel met foto commando - typeset hoofding met foto tot aan de paginarand
%% Foto staat links op oneven pagina's, rechts op oneven pagina's (altijd aan de outer margin)
%% \artikelfoto{titel}{subtitel}{auteur}{foto}
%% Argument 1: titel 
%% Argument 2: subtitel, mag leeg zijn
%% Argument 3: auteur, mag leeg zijn
%% Argument 4: pad/bestandsnaam foto (hiervan wordt een strook met breedte \aflooplen links (oneven pagina) of rechts (even pagina) afgesneden); de breedte staat vast en zal altijd zelfde zijn (10.4cm incl. afloop), de hoogte kun je mee variëren (6cm hoog is aanbevolen)
\newlength{\artikelimgwidth}				% breedte afbeelding naast titel artikel
\setlength{\artikelimgwidth}{\twocoltextwidth+\outermargin+\aflooplen}
\newlength{\artikelimgheight}				% hoogte afbeelding naast titel artikel
\newlength{\artikelhoofdheight}				% minimumhoogte artikelhoofding
\newlength{\artikelhoofdheightmin}			% absolute minimumhoogte artikelhoofding
\setlength{\artikelhoofdheightmin}{50mm}

\newcommand*{\artikelfoto}[4]{%
	\settoheight{\artikelimgheight}{\includegraphics[width=\artikelimgwidth,keepaspectratio]{#4}}%  % haal de hoogte van de afbeelding op
	\setlength{\artikelimgheight}{\dimexpr\artikelimgheight-13mm\relax}%  % -13mm ivm yshift
	\MaxLength{\artikelimgheight}{\artikelhoofdheightmin}{\artikelhoofdheight}%
	\checkoddpage%
	\ifoddpage%
		\begin{tikzpicture}[remember picture]%  		% artikelhoofding tekst oneven
			\node[minimum height=\artikelhoofdheight,text width=\twocoltextwidth,inner sep=0pt] (nodebox) {};%
			\node[anchor=north west,text width=\twocoltextwidth,inner sep=0pt] at (nodebox.north west) {\artikel{#1}{#2}{#3}};%
		\end{tikzpicture}%
		\begin{tikzpicture}[remember picture,overlay]% 	% artikelhoofding foto oneven
			\node[anchor=north west,inner sep=0pt,xshift=(\twocoltextwidth+\columnsep),yshift=13mm] at (nodebox.north west)%
			{\includegraphics[width=\artikelimgwidth,keepaspectratio]{#4}};%
		\end{tikzpicture}%
	\else%
		\begin{tikzpicture}[remember picture]%			% artikelhoofding tekst even
			\node[minimum height=\artikelhoofdheight,text width=\textwidth,inner sep=0pt,xshift=(\twocoltextwidth+\columnsep)] (nodebox) {};%
			\node[anchor=north east,text width=\twocoltextwidth,inner sep=0pt,align=flush right] at (nodebox.north east) {\artikelrechts{#1}{#2}{#3}};%
		\end{tikzpicture}%
		\begin{tikzpicture}[remember picture,overlay]%	% artikelhoofding foto even
			\node[anchor=north east,inner sep=0pt,xshift=-(\twocoltextwidth+\columnsep),yshift=13mm] at (nodebox.north east)%
			{\includegraphics[width=\artikelimgwidth,keepaspectratio]{#4}};%
		\end{tikzpicture}%
	\fi%
	\markright{#1}%   % voor artikelnaam in header, herhalen want werkt niet binnen tikzpicture
}


%% Voorbeeldafbeelding
\newcommand*{\dummyimgartikel}{%
	%\checkoddpage% % niet nodig, al gecheckt in \artikelfoto
	\ifoddpage
		img/dummy-104x60mm-rechts.jpg%
	\else
		img/dummy-104x60mm-links.jpg%
	\fi
}



