%% RUBRIEKEN & ARTIKELS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \rubriek{type}{titel} 						- begin nieuwe rubriek van gegeven type
%% \rubriekkleur 								- kleur van de huidige rubriek
%% \artikel{titel}{subtitel}{auteur} 			- begin nieuw artikel
%% \artikelfoto{titel}{subtitel}{auteur}{foto} 	- begin nieuw artikel met foto (foto staat altijd tegen de paginarand, 10.4cm breed incl. 5mm afloop)
%% \auteurslot{auteur} 							- auteur op het eind van een artikel (bv. redactioneel, bibwijzer)

%% TUSSENTITELS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \section{}, \subsection{}, \subsubsection{}, \paragraph{} - hierachie van tussentitels
%% \section, \subsection 						- genummerde tussentitels
%% \section*, \subsection* 						- ongenummerde tussentitels (met ster *)
%% \subsubsection, \paragraph 					- altijd ongenummerd

%% BRONNEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \begin{bronnen} \item bron ... \end{bronnen}	- bronvermelding op het eind van een artikel

%% AFBEELDINGEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Noot: gebruik enkel deze, gebruik GEEN {figure} omgeving, dit werkt namelijk niet binnen een multicols omgeving (geen floats toegestaan)
%% \afbeelding[breedte]{bestand}{onderschrift}{label}	- plaats afbeelding in lijn met tekst
%% \afbeeldingtotrand{l|r|b}{bestand}					- plaats een decoratieve afbeelding die tot de paginarand loopt (in multicols kolom: 10.4cm breed incl. 5mm afloop; buiten multicols kolom: 22cm breed incl. 2x 5mm afloop)

%% LESACTIVITEITEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \begin{lesactiviteit}{titel} ... \end{lesactiviteit}	- lesactiviteit kader
%% \lestitel, \lessubtitel								- tussentitels lesactiviteit (ongenummerd en in kleur)

%% OPSOMMINGEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \begin{vraagenantwoord} \vraag{...} \antwoord{...} ... \end{vraagenantwoord} - omgeving voor een vraag/antwoord structuur (gebruik bv. binnen lesactiviteit)
%% 		\vraag{tekst}			- voor de vraagtekst binnen {vraagenantwoord} omgeving
%% 		\antwoord{tekst}		- voor de antwoordtekst binnen {vraagenantwoord} omgeving
%% \begin{enumerate}\ item ... \end{enumerate} 	- genummerde opsomming
%% \begin{itemize}\ item ... \end{itemize} 		- ongenummerde opsomming

%% CITATEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \begin{citaat}[auteur/bron] ... \end{citaat}		- een citaat met optionele auteur/bron

%% KADERS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \begin{kader}{type}{titel} ... \end{kader} 		- plaats tekst binnen een kader

%% TABELLEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Noot: gebruik enkel dit, gebruik GEEN {table} omgeving, dit werkt namelijk niet binnen een multicols omgeving (geen floats toegestaan)
%% \begin{tabel} \begin{tabular}{...} ... \end{tabular} \end{tabel}

%% OVERIGE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \clearpage  		- manuele paginabreak, nodig boven elk artikel behalve het 1ste artikel in een rubriek
%% \clearcolumn 	- manuele kolombreak (eindig de linkerkolom, ga naar de rechterkolom)
%% \smallskip, \medskip, \bigskip - extra verticale ruimte creëren
%% \comments{} 		- snel meerdere lijnen in comment zetten (verbergen in output)

%% AFMETINGEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Tekstbreedte buiten multicols kolom:	16.2cm
%% Tekstbreedte binnen lesactiviteit: 	15.0cm
%% Tekstbreedte binnen multicols kolom:	 7.5cm
%% Breedte afbeelding tot paginarand buiten multicols kolom: 22.0cm (=21cm + 2x 5mm afloop, dit is de volledige paginabreedte)
%% Breedte afbeelding tot paginarand binnen multicols kolom: 10.4cm (7.5cm + 2.4cm marge + 5mm afloop)

