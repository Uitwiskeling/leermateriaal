%% DEFINIEER RUBRIEKEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand*{\rubriekkleur}{kleurnone}
\newcommand*{\rubriekimg}{}
\newcommand*{\rubriekheaderimg}{}
\newcommand*{\rubriekcheckmark}{}
\newcommand*{\rubriekpagenrbg}{}

%% Start nieuwe rubriek commando - typeset hoofding en stel o.a. de rubriekkleur in
%% \rubriek{type}{titel}
%% Argument 1: type rubriek: redactioneel, spin, loep, bib, actua
%% Argument 2: titel die getoond wordt
\newcommand*{\rubriek}[2]{%
	\clearpage%
	\IfEqCase{#1}{%
		{redactioneel}{%
			\renewcommand*{\rubriekkleur}{kleurredact}}%
		{spin}{%
			\renewcommand*{\rubriekkleur}{kleurspin}}%
		{loep}{%
			\renewcommand*{\rubriekkleur}{kleurloep}}%
		{bib}{%
			\renewcommand*{\rubriekkleur}{kleurbib}}%
		{actua}{%
			\renewcommand*{\rubriekkleur}{kleuractua}}%
		}[\PackageError{rubriek}{Ongedefinieerd rubriektype: #1}{}]%
	\renewcommand*{\rubriekimg}{imgDesign/RubriekImg_#1.jpg}%
	\renewcommand*{\rubriekheaderimg}{imgDesign/Uitwiskeling_logo_mini_#1.png}%
	\renewcommand*{\rubriekcheckmark}{imgDesign/checkmark_#1.png}%
	\renewcommand*{\rubriekpagenrbg}{imgDesign/paginanrbg_#1.png}%
	\part*{#2}%							% rubriek is eigenlijk ongenummerde part
	\phantompageref%					% zodat links naar linkerbovenhoek pagina gaan
	\addcontentsline{toc}{part}{#2}%	% voor rubrieknaam in TOC
	\markboth{#2}{}%  					% voor rubrieknaam in header
	\thispagestyle{plain}%				% enkel footer, geen header
}

%% Opmaak rubriekhoofding (via titlesec, rubriek = numberless part)
\titleclass{\part}{top} % zet part op "top" type om standaard erop volgende paginabreak te verwijderen

\titleformat{name=\part,numberless}{%
	\sffamily\ebseries\fontsize{38}{46}\color{white}\selectfont\raggedleft}{}{0pt}%
	{%
		\begin{tikzpicture}[remember picture,overlay]%
			\node[anchor=north west,inner sep=0pt,xshift=-\aflooplen+\afloop,yshift=\aflooplen-\afloop] at (current page.north west)%
			{\includegraphics[width=\pagewidth+2\aflooplen,keepaspectratio]{\rubriekimg}};%
		\end{tikzpicture}%
	\begin{adjustwidth}{0mm}{0mm}\vspace{.9ex}\raggedleft\MakeUppercase{#1}\vspace{-1ex}\end{adjustwidth}%
	}%
	[\thispagestyle{plain}]

\titlespacing*{name=\part,numberless}{0pt}{-40mm}{30pt}

%% NOT USED: numbered parts
%\titleformat{\part}{}{}{}{}[]
%\titlespacing*{\part}{0pt}{-40mm}{30pt}


