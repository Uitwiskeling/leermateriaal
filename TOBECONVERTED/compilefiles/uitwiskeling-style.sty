%% AFBEELDING IN LIJN MET TEKST %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Noot: figure omgeving werkt niet binnen een multicols omgeving (geen floats toegestaan)
%% Hier definiëren we een nieuwe figuur omgeving die wel overal werkt, inclusief onderschrift en label
\newlength{\figwidth}
\newlength{\figwidthuser}

%% ENKEL HULPMACRO: Nieuwe figuur omgeving
%% \captionsetup stelt de hyperlink anchor in voor deze custom omgeving (zodat link naar top van figuur gaat ipv naar de caption)
\newenvironment{afbeeldingenv}[1][\linewidth]
	{\par\smallskip\noindent\minipage{#1}\captionsetup{type=figure}\centering}
	{\endminipage\par\smallskip}


%% Nieuw \afbeelding commando om makkelijker figuren met onderschrift te typesetten
%% \afbeelding[breedte]{bestand}{onderschrift}{label}
%% Argument 1: (optioneel) breedte figuur, wordt automatisch op max. tekstbreedte ingesteld
%% Argument 2: pad & bestandsnaam
%% Argument 3: onderschrift (caption, mag leeg zijn)
%% Argument 4: label om naar te refereren via \ref{label} of \autoref{label} (mag leeg zijn)
%% Noot: \linewidth =\twocoltextwidth in two column mode; =\textwidth in single column mode (kan afwijken binnen een lijst, bv. vraagenantwoord omgeving)

\newcommand*{\afbeelding}[4][\linewidth]{
	\setlength{\figwidthuser}{#1}	% nodig om als lengte te kunnen vergelijken
	\MinLength{\figwidthuser}{\linewidth}{\figwidth}  % figuur mag niet breder dan tekst zijn
	\begin{afbeeldingenv}%
		\includegraphics[width=\figwidth,keepaspectratio]{#2}%
		\setbox0=\vbox{#3\unskip}\ifdim\wd0=0pt%
			%#caption is leeg, dus geen caption tonen (ook niet "Figuur #", dus label heeft ook geen zin)
            % TODO: caption zelf is aligned zo links mogelijk, niet in lijn met figuur zelf
		\else%
			\caption{#3}\label{#4}%
		\fi%
	\end{afbeeldingenv}%
}



%% DECORATIEVE AFBEELDING TOT DE PAGINARAND %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Commando voor decoratieve afbeelding tot paginarand (decoratief dus zonder caption of label)
%% \afbeeldingtotrand{l|r|b}{bestand}
%% Argument 1: l(inks tot rand), r(echts tot rand), b(eide kanten tot rand) -> gebruiker moet aangeven in welke context de afbeelding nodig is, kan niet automatisch detecteren of je in linker- of rechterkolom zit
%% Argument 2: pad + bestandsnaam (afbeelding moet afloop omvatten! - extra strook met breedte \aflooplen aan de kant(en) waar die de paginarand raakt)
\newlength{\leftpagemargin}
\newlength{\rightpagemargin}
\newcommand*{\afbeeldingtotrand}[2]{%
	\ifoddpage%
		\setlength{\leftpagemargin}{\innermargin}%
		\setlength{\rightpagemargin}{\outermargin}%
	\else%
		\setlength{\leftpagemargin}{\outermargin}%
		\setlength{\rightpagemargin}{\innermargin}%
	\fi%
	\IfEqCase{#1}{%
		{l}{%
			\afbeeldingtotrandbasis{\twocoltextwidth}{\dimexpr\leftpagemargin+\aflooplen\relax}{0pt}{#2}}%
		{r}{%
			\afbeeldingtotrandbasis{\twocoltextwidth}{0pt}{\dimexpr\outermargin+\aflooplen\relax}{#2}}%
		{b}{%
			\afbeeldingtotrandbasis{\textwidth}{\dimexpr\leftpagemargin+\aflooplen\relax}{\dimexpr\outermargin+\aflooplen\relax}{#2}}%
	}[\PackageError{afbeeldingtotrand}{Ongedefinieerd type: #1. Kies type l, r of b.}{}]%
}

%% ENKEL HULPMACRO
\newcommand*{\afbeeldingtotrandbasis}[4]{%
	\par\medskip\noindent%
	\makebox[#1][l]{%	% omsluit de minipage om overfull warnings te stoppen
	\begin{minipage}{#1}%
		\begin{adjustwidth}{-#2}{-#3}%
			\includegraphics[width=#1+#2+#3,keepaspectratio]{#4}%
		\end{adjustwidth}%
	\end{minipage}}\par\medskip%
}



%% TABELLEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Noot: table omgeving werkt niet binnen een multicols omgeving (geen floats toegestaan)
%% Hier definiëren we een nieuwe tabel omgeving die wel overal werkt, inclusief onderschrift en label

%% Nieuwe tabel omgeving
%% \captionsetup stelt de hyperlink anchor in voor deze custom omgeving (zodat link naar top van tabel gaat ipv naar de caption)
\newenvironment{tabel}[1][\linewidth]
{\par\smallskip\noindent\minipage{#1}\captionsetup{type=table}\centering%
	\rowcolors{2}{\rubriekkleur!10}{white}%		% gestreepte rijen in kleur/wit
	\arrayrulecolor{\rubriekkleur}%				% scheidingslijnen in kleur
	\setlength{\tabcolsep}{2mm}% 				% kolomafstand, wordt aan beide kanten van kolom bijgeteld
	\ifbool{InMulticol}{\setlength{\tabcolsep}{1mm}}{}%	% kleinere kolomafstand in multicol
}{\endminipage\par\smallskip}


%% Nieuw kolomtype C{width}: gecentreerde fixed width kolom (zoals m{2cm} maar dan C{2cm})
\newcolumntype{C}[1]{>{\centering\arraybackslash}m{#1}}	% op basis van kolomtype m, kan ook p of b zijn


%% Tabelhoofding opmaak (per kolom, kan niet voor de hele rij ineens zonder grotere hacks)
%% Omsluit een kolomhoofding hierin, bv. \tableheader{Kolom 1} & \tableheader{Kolom 2}
\newcommand*{\tableheader}[1]{{\cellcolor{\rubriekkleur}\sffamily\bfseries\color{white}#1}}


%% Dikkere horizontale lijnen in tabellen met \hlinethick (gebruik waar gewenst in plaats van \hline)
\newlength{\arrayrulewidthdef}
\setlength{\arrayrulewidthdef}{\arrayrulewidth}  % arrayrulewidth is globaal dus sla originele definitie op om hierop terug te kunnen zetten
\newcommand*{\hlinethick}{\noalign{\global\arrayrulewidth=2.5\arrayrulewidthdef} \hline \noalign{\global\arrayrulewidth=1.5\arrayrulewidthdef}}



%% LESACTIVITEIT KADER %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Tussentitels lesactiviteit (in kleur): \lestitel{titel} en \lessubtitel{titel}
\newcommand*{\lestitel}[1]{{\color{\rubriekkleur}\section*{#1}}}
\newcommand*{\lessubtitel}[1]{{\color{\rubriekkleur}\subsection*{#1}}}

%% Lesactiviteit omgeving
%% \begin{lesactiviteit}{titel} ... \end{lesactiviteit}
%% Argument 1: titel lesactiviteit
\newenvironment*{lesactiviteit}[1]
	{\lestitel{#1}}
	{\vspace*{\bigskipamount}}

%% Opmaak van de omkadering (met mdframed package)
\surroundwithmdframed[%
	leftmargin=0pt,rightmargin=0pt,%
	skipabove=\topskip,skipbelow=\topskip,%
	innerleftmargin=5mm,innerrightmargin=5mm,%
	innertopmargin=4pt,innerbottommargin=4pt,%
	hidealllines=true,leftline=true,rightline=true,%
	linecolor=\rubriekkleur!30,%
	linewidth=1mm,%
	frametitle={LESACTIVITEIT \enspace \raisebox{-.15\height}{\makebox[2mm][l]{\includegraphics[width=4mm,keepaspectratio]{imgDesign/lamp_wit.png}}}},%
	frametitlefont={\sffamily\bfseries\small\color{white}},%
	frametitlealignment={\raggedleft},%
	frametitlebackgroundcolor=\rubriekkleur,%
	frametitleaboveskip=3pt,frametitlebelowskip=3.2pt,%
	%repeatframetitle=true,%
	singleextra={\draw[line width=8pt, color=\rubriekkleur] ([xshift=3pt,yshift=4pt]current bounding box.south west) -- ([xshift=-3pt,yshift=4pt]current bounding box.south east);},%
	secondextra={\draw[line width=8pt, color=\rubriekkleur] ([xshift=3pt,yshift=4pt]current bounding box.south west) -- ([xshift=-3pt,yshift=4pt]current bounding box.south east);}%
	]{lesactiviteit}



%% VRAAG & ANTWOORD %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Nieuwe genummerde lijst voor vraag & antwoord (bv. lesoefeningen, maar kan ook buiten lesactiviteit gebruikt worden)
%% \begin{vraagenantwoord} \vraag{vraagtekst} \antwoord{antwoordtekst} ... \end{vraagenantwoord}
\newlist{vraagenantwoord}{enumerate}{2}  %max depth = 2: maximum 1 geneste lijst

%% Opmaak van het eerste niveau van deze lijst: 1, 2 etc
\setlist[vraagenantwoord]{label=\colorbox{\rubriekkleur}{\makebox[4.5mm][c]{\arabic*}}, font={\sffamily\ebseries\smaller\color{white}}, leftmargin=*, itemsep={2ex plus .4ex minus .4ex}, parsep={.5ex plus .1ex minus .1ex}, topsep={1ex plus .2ex minus .2ex}} 

%% Opmaak van de eerste (en enige) geneste lijst: (a), (b) etc
\setlist*[vraagenantwoord,2]{label=\colorbox{\rubriekkleur}{\makebox[4.5mm][c]{\alph*}}, topsep={2ex plus .4ex minus .4ex}}

%% Vraag en antwoord commando's, enkel te gebruiken binnen de vraagenantwoord omgeving
%% \vraag{vraagtekst}
%% \antwoord{antwoordtekst}
\newcommand*{\vraag}[1]{\item{#1}\par}
\newcommand*{\antwoord}[1]{\makebox[0pt][r]{\includegraphics[width=3mm,keepaspectratio]{\rubriekcheckmark}\hspace*{\labelsep}}\textit{#1}\par}



%% CITATEN %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Nieuwe citaat omgeving
%% \begin{citaat}[auteur/bron] ... \end{citaat} of \begin{citaat} ... \end{citaat}
%% Argument (optioneel): auteur of bron van het citaat
\newenvironment*{citaat}[1][]{%
	\setbox0=\vbox{#1\unskip}\ifdim\wd0=0pt%
		\def\quotesource{}%		%geen auteur/bron (default)
	\else%
		\def\quotesource{\parskip=\smallskipamount\par\nobreak{\raggedleft---~#1\par}}%
	\fi%
	\begingroup%  % maak margeaanpassingen lokaal binnen deze group
	\setlength{\leftmargini}{7.5mm}%	% stel marges in
	\medskip\begin{quote}\itshape}
	{{\quotesource}\end{quote}\endgroup\medskip}



%% MULTIFUNCTIONEEL KADER %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \begin{kader}{type}{titel} ... \end{kader}
%% Argument 1: type kader, bv. "Stelling", "Bewijs", ... (mag leeg zijn)
%% Argument 2: titel (mag leeg zijn)
\newenvironment*{kader}[2]{%
	\setbox0=\vbox{#1\unskip}\ifdim\wd0=0pt%
		% type kader is leeg
	\else%
		{\sffamily{\color{\rubriekkleur}{\ebseries#1}\enspace{\Large\raisebox{-.3ex}{\normalfont\textbullet}}}\enspace}%
	\fi%
	\setbox0=\vbox{#2\unskip}\ifdim\wd0=0pt%
		% titel kader is leeg
	\else%
		{\sffamily\bfseries#2}\par%
	\fi%
	}{}

%% Opmaak van de omkadering (met mdframed package)
\surroundwithmdframed[%
	default,%
	leftmargin=0pt,rightmargin=0pt,%
	skipabove=\topskip,skipbelow=0pt,%
	innerleftmargin=3mm,innerrightmargin=3mm,%
	innertopmargin=3mm,innerbottommargin=3mm,%
	linecolor=\rubriekkleur,%
	linewidth=1.5pt,%
	backgroundcolor=\rubriekkleur!10%
	]{kader}




