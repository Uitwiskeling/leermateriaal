%% Afmetingen pagina, papier, afloop, marges
%% Afloop wordt na het drukken afgesneden, zodat elementen tot de paginarand kunnen lopen zonder dat er witte randjes ontstaan bij afsnijden
\newlength{\pagewidth}
\setlength{\pagewidth}{210mm}		% A4 breedte (paginabreedte na afsnijding)
\newlength{\pageheight}
\setlength{\pageheight}{297mm}		% A4 hoogte (paginahoogte na afsnijding)
			
\newlength{\aflooplen}
\setlength{\aflooplen}{5mm}
\newlength{\afloop}
\iftoggle{printversion}{ % versie voor drukker, inclusief afloop
	\setlength{\afloop}{\aflooplen}
}{ % digitale versie, zonder afloop
	\setlength{\afloop}{0mm}
} % end iftoggle

\newlength{\paperwidthfull}
\setlength{\paperwidthfull}{\pagewidth+2\afloop} 	% papierbreedte vóór afsnijding
\newlength{\paperheightfull}
\setlength{\paperheightfull}{\pageheight+2\afloop} 	% papierhoogte vóór afsnijding

\newlength{\outermargin}
\setlength{\outermargin}{24mm}		% buitenste marge (na afsnijding)
\newlength{\innermargin}
\setlength{\innermargin}{24mm}		% binnenste marge (na afsnijding)

\newlength{\extendmargin}
\setlength{\extendmargin}{10mm}		% verbreding marge voor kop- & voetteksten etc


%% Stel paginaindeling in via geometry package
\geometry{papersize={\paperwidthfull, \paperheightfull}, inner=\innermargin, outer=\outermargin}

\iftoggle{printversion}{ %versie voor drukker, inclusief afloop
	\geometry{layoutsize={\pagewidth, \pageheight}, layoutvoffset=\afloop, layouthoffset=\afloop}	% positioneer de pagina op het papier
}{} %end iftoggle

\geometry{marginparwidth=60pt, top=30mm, bottom=35mm, headheight=22pt, headsep=15mm, footskip=12mm}
%headsep is afstand tussen bovenkant body en onderkant header
%footskip is afstand tussen onderkant body en onderkant footer


%% Afmetingen pagina & papier voor PDF page boxes (belangrijk voor printversie)
%% pdfpageattr boxes should be given in PS points (bp): 1 PS point = 1/72 inch = 1bp in TeX (NOT pt! 1pt in TeX = 1/72.27 inch...)
\makeatletter
\edef\paperwidthpt{\strip@pt\dimexpr0.996264009963\paperwidthfull\relax} % papierbreedte in PS points
\edef\paperheightpt{\strip@pt\dimexpr0.996264009963\paperheightfull\relax} % papierhoogte in PS points
\edef\aflooppt{\strip@pt\dimexpr0.996264009963\afloop\relax} % afloop in PS points
\edef\pagetoprightx{\strip@pt\dimexpr0.996264009963\pagewidth+0.996264009963\afloop\relax}
\edef\pagetoprighty{\strip@pt\dimexpr0.996264009963\pageheight+0.996264009963\afloop\relax}
\makeatother

\edef\mypdfpageattr{
	/MediaBox [0 0 \paperwidthpt\space\paperheightpt]^^J
	/BleedBox [0 0 \paperwidthpt\space\paperheightpt]^^J
	/TrimBox [\aflooppt\space\aflooppt\space\pagetoprightx\space\pagetoprighty]
}
\expandafter\pdfpageattr\expandafter{\mypdfpageattr}


%% Kolom-gerelateerde afmetingen
\setlength{\columnsep}{12mm}					% afstand tussen de twee kolommen
\newlength{\twocoltextwidth}					% breedte van 1 tekstkolom wanneer er 2 kolommen zijn
\setlength{\twocoltextwidth}{(\textwidth-\columnsep)/2}


