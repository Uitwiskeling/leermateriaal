%% Multiline comment - snel een grote blok code weglaten uit de output door deze te omsluiten met \comments{}
\newcommand{\comments}[1]{\ignorespaces}

%% Geeft in #3 het minimum van de twee lengtes #1 and #2 terug
\newcommand{\MinLength}[3]{%
	\ifthenelse{\lengthtest{\the#1<\the#2}}
	{\setlength{#3}{#1}}
	{\setlength{#3}{#2}}}

%% Geeft in #3 het maximum van de twee lengtes #1 and #2 terug
\newcommand{\MaxLength}[3]{%
	\ifthenelse{\lengthtest{\the#1>\the#2}}
	{\setlength{#3}{#1}}
	{\setlength{#3}{#2}}}

%% Hyperlink anchor op bovenkant van pagina (bv. voor rubriek TOC links & bookmarks)
